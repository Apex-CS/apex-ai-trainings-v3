{
  "mappings": [
    {
      "name": "POST deploy — DEV or STAGING",
      "request": {
        "method": "POST",
        "url": "/api/deployments",
        "bodyPatterns": [
          { "matchesJsonPath": "$[?(@.environment =~ /DEV|STAGING/i)]" }
        ]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "status": "DEPLOYED",
          "environment": "{{jsonPath request.body '$.environment'}}",
          "version": "{{jsonPath request.body '$.version'}}"
        }
      }
    },
    {
      "name": "GET deployment status",
      "request": {
        "method": "GET",
        "urlPattern": "/api/deployments/[^/]+/[^/]+"
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "status": "RUNNING",
          "version": "v2.4.1",
          "lastDeployedAt": "{{now format='yyyy-MM-dd\\'T\\'HH:mm:ss\\'Z\\''}}"
        }
      }
    }
  ]
}
